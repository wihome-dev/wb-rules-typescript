{
  "compilerOptions": {
    "target": "es5",
    "module": "es2015",
    "moduleResolution": "node",
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "@wbm/*": [
        "src/wb-rules-modules/*"
      ]
    },
    "allowJs": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "alwaysStrict": true,
    "noImplicitThis": true
  },
  "include": [
    "src/wb-rules/*",
    "src/wb-rules-modules/**/*",
    "types/*"
  ],
  "tsc-alias": {
    "replacers": {
      "wb-rules-modules": {
        "file": "tsc-replacers/wb-replacer.js",
        "enabled": true
      }
    }
  }
}
